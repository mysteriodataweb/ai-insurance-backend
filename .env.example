# Database (Supabase pooler, session mode - IPv4)
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Groq (free AI API)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=30

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_REGISTRATION=true

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Run AI extraction + risk scoring automatically when a claim is submitted
AUTO_PROCESS_CLAIMS=true

# App
APP_ENV=development
APP_DEBUG=false
